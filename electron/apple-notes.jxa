/**
 * electron/apple-notes.jxa — JXA reader for Apple Notes (iCloud + On My Mac)
 *
 * Run via:
 *   osascript -l JavaScript apple-notes.jxa <sinceISO> <untilISO> [preview|snippet|bodies] [idsJSON]
 *
 * `preview` (default): walk Notes folders and read id, title, and modification date in bulk. No note bodies. A library-wide `whose()` hangs or returns nothing on a large Notes library.
 * `snippet`: truncated plaintext for given ids (preview on the swipe card).
 * `bodies`: full plaintext for given ids (bulk-add / save for later).
 */
function stripHtml(input) {
  if (!input) return ""
  var s = String(input)
  s = s.replace(/<br\s*\/?>/gi, "\n")
  s = s.replace(/<\/(p|div|h[1-6]|li|tr|blockquote)>/gi, "\n")
  s = s.replace(/<[^>]+>/g, "")
  s = s.replace(/&nbsp;/gi, " ")
  s = s.replace(/&amp;/gi, "&")
  s = s.replace(/&lt;/gi, "<")
  s = s.replace(/&gt;/gi, ">")
  s = s.replace(/&quot;/gi, '"')
  s = s.replace(/&#(\d+);/g, function (_, n) {
    return String.fromCharCode(Number(n))
  })
  s = s.replace(/\n{3,}/g, "\n\n")
  return s.trim()
}

function isTrashFolder(name) {
  var n = String(name || "").toLowerCase()
  return n === "recently deleted" || n.indexOf("recently deleted") !== -1
}

function iso(d) {
  try {
    return d instanceof Date ? d.toISOString() : new Date(d).toISOString()
  } catch (e) {
    return ""
  }
}

function asArray(value) {
  if (value == null) return []
  if (Array.isArray(value)) return value
  return [value]
}

function bulk(spec, getter) {
  try {
    return asArray(getter(spec))
  } catch (e) {
    return null
  }
}

function readBodyOne(note) {
  try {
    if (note.passwordProtected()) return { body: "", passwordProtected: true }
  } catch (e) {}
  try {
    var plain = note.plaintext()
    if (plain != null && String(plain).length) {
      return { body: String(plain), passwordProtected: false }
    }
  } catch (e) {}
  try {
    return { body: stripHtml(note.body()), passwordProtected: false }
  } catch (e) {
    return { body: "", passwordProtected: false }
  }
}

var PREVIEW_MAX = 500

function inWindow(modified, since, until) {
  if (!(modified instanceof Date)) {
    try { modified = new Date(modified) } catch (e) { return null }
  }
  if (!(modified instanceof Date) || isNaN(modified.getTime())) return null
  if (modified < since || modified > until) return null
  return modified
}

function pushPreview(results, seen, id, title, folderName, accountName, modified) {
  id = String(id || "")
  if (!id || seen[id]) return
  seen[id] = true
  results.push({
    id: id,
    title: String(title || ""),
    body: "",
    folder: folderName,
    account: accountName,
    createdAt: "",
    modifiedAt: iso(modified),
    passwordProtected: false,
  })
}

function collectFolder(folder, accountName, since, until, results, seen) {
  if (results.length >= PREVIEW_MAX) return
  var folderName = ""
  try { folderName = String(folder.name()) } catch (e) {}
  if (isTrashFolder(folderName)) return

  var spec = folder.notes
  var ids = bulk(spec, function (s) { return s.id() })
  var names = bulk(spec, function (s) { return s.name() })
  var mods = bulk(spec, function (s) { return s.modificationDate() })
  if (ids && mods) {
    var n = Math.min(ids.length, mods.length)
    for (var i = 0; i < n; i++) {
      if (results.length >= PREVIEW_MAX) return
      var modified = inWindow(mods[i], since, until)
      if (!modified) continue
      var title = names && names[i] != null ? names[i] : ""
      pushPreview(results, seen, ids[i], title, folderName, accountName, modified)
    }
  }

  var children = []
  try { children = folder.folders() } catch (e) {}
  for (var c = 0; c < children.length; c++) {
    collectFolder(children[c], accountName, since, until, results, seen)
    if (results.length >= PREVIEW_MAX) return
  }
}

function listPreview(Notes, since, until) {
  var results = []
  var seen = {}
  var accounts = []
  try { accounts = Notes.accounts() } catch (e) { accounts = [] }
  for (var a = 0; a < accounts.length; a++) {
    if (results.length >= PREVIEW_MAX) break
    var account = accounts[a]
    var accountName = ""
    try { accountName = String(account.name()) } catch (e) {}
    var folders = []
    try { folders = account.folders() } catch (e) { folders = [] }
    for (var f = 0; f < folders.length; f++) {
      collectFolder(folders[f], accountName, since, until, results, seen)
      if (results.length >= PREVIEW_MAX) break
    }
  }
  return results
}

function fetchBodies(Notes, ids, maxChars) {
  var cap = typeof maxChars === "number" && maxChars > 0 ? maxChars : 20000
  var results = []
  for (var i = 0; i < ids.length; i++) {
    var id = String(ids[i] || "")
    if (!id) continue
    var note = null
    try {
      note = Notes.notes.byId(id)
    } catch (e) {
      try {
        var found = Notes.notes.whose({ id: id })()
        note = found && found[0]
      } catch (e2) {
        note = null
      }
    }
    if (!note) continue

    var info = readBodyOne(note)
    var folder = ""
    var account = ""
    var title = ""
    var createdAt = ""
    var modifiedAt = ""
    try { title = String(note.name()) } catch (e) {}
    try { folder = String(note.container().name()) } catch (e) {}
    try { account = String(note.container().container().name()) } catch (e) {}
    try { createdAt = iso(note.creationDate()) } catch (e) {}
    try { modifiedAt = iso(note.modificationDate()) } catch (e) {}

    results.push({
      id: id,
      title: title,
      body: String(info.body || "").slice(0, cap),
      folder: folder,
      account: account,
      createdAt: createdAt,
      modifiedAt: modifiedAt,
      passwordProtected: !!info.passwordProtected,
    })
  }
  return results
}

function run(argv) {
  var since = new Date(argv[0])
  var until = new Date(argv[1])
  if (isNaN(since.getTime())) throw new Error("invalid since date")
  if (isNaN(until.getTime())) throw new Error("invalid until date")
  var mode = String(argv[2] || "preview").toLowerCase()
  var Notes = Application("Notes")

  var results
  if (mode === "bodies" || mode === "snippet") {
    var ids = []
    try {
      ids = JSON.parse(argv[3] || "[]")
    } catch (e) {
      ids = []
    }
    if (!Array.isArray(ids)) ids = []
    results = fetchBodies(Notes, ids.slice(0, 200), mode === "snippet" ? 800 : 20000)
  } else {
    results = listPreview(Notes, since, until)
  }

  results.sort(function (a, b) {
    if (a.modifiedAt < b.modifiedAt) return 1
    if (a.modifiedAt > b.modifiedAt) return -1
    return 0
  })

  return JSON.stringify(results)
}
