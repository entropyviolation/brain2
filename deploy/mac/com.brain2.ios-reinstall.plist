<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.brain2.ios-reinstall</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE_PATH__</string>
    <string>__REPO_PATH__/scripts/ios-reinstall.mjs</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO_PATH__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__PATH__</string>
    <key>COGS_IOS_TEAM_ID</key>
    <string>__TEAM_ID__</string>
  </dict>
  <!-- Every 3 hours, and once at login. Most runs only check the date and exit. -->
  <key>StartInterval</key>
  <integer>10800</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/brain2-ios-reinstall.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/brain2-ios-reinstall.log</string>
</dict>
</plist>
