<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.brain2.backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE_PATH__</string>
    <string>__REPO_PATH__/scripts/backup-data.mjs</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO_PATH__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>COGS_BACKUP_DIR</key>
    <string>__BACKUP_DIR__</string>
    <key>COGS_BACKUP_KEEP</key>
    <string>14</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/brain2-backup.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/brain2-backup.log</string>
</dict>
</plist>
