# Copy to /etc/brain2-capture.env on the VM (chmod 600). Never commit the real one.
COGS_TELEGRAM_BOT_TOKEN=
# PUBLIC key from `node scripts/capture-keygen.mjs` on YOUR device. Never the private key.
COGS_CAPTURE_PUBLIC_KEY=
# Long random string. Your device sends it as a bearer token. `openssl rand -hex 32`
COGS_CAPTURE_TOKEN=
# REQUIRED. Only texts from these chat ids are kept (comma separated). The box
# refuses to start without it. To find yours: Settings -> Message ingest in the
# desktop app shows it. Or text the bot once, then (with the box stopped) run
#   curl -s "https://api.telegram.org/bot<TOKEN>/getUpdates"
# and read result[].message.chat.id. A private chat id is a positive number.
# Opt out (not recommended): leave this empty and set COGS_CAPTURE_ALLOW_ANY_CHAT=1
COGS_CAPTURE_CHAT_IDS=
# REQUIRED for the Tailscale setup. This VM's tailnet IPv4 (`tailscale ip -4`,
# starts with 100.). The box listens on this address only, never on the public one.
COGS_CAPTURE_BIND=
# healthchecks.io ping URL; it messages you on Telegram when pings stop.
COGS_HEALTHCHECK_URL=
COGS_CAPTURE_PORT=8788
COGS_CAPTURE_DIR=/var/lib/brain2-capture
