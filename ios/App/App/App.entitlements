<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- NFC Tag Reading is left out. A personal team cannot sign a profile that includes it, so the phone build would not install. Add com.apple.developer.nfc.readersession.formats (NDEF, TAG) back on a paid Apple Developer account. -->
<plist version="1.0">
<dict>
	<key>com.apple.developer.healthkit</key>
	<true/>
</dict>
</plist>
