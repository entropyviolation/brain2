/**
 * scripts/baby-flora-snap.mts — The ground's plants from ComfyUI pictures into little sprites
 *
 *   npx tsx scripts/baby-flora-snap.mts [preview.png]
 *
 * For each plant in `PLANTS` (`scripts/baby-flora-queue.mjs`) it picks one `flora-*-<id>_*.png` from the ComfyUI output folder:
 * the newest picture you liked in `/lab/baby-gens` (`data/baby-game-gens.json`), else the newest that is not noped, else the newest.
 * `lib/baby-game/flora.json` can name a file for an id outright. The picture is cut out, averaged down and put on a small palette
 * by `snap` from `baby-furniture-snap.mts`. Output is `lib/baby-game/flora-sprites.ts`, and, if you pass a path, a contact sheet.
 */

import fs from "node:fs"
import os from "node:os"
import path from "node:path"
import sharp from "sharp"
import { snap, type Snapped } from "./baby-furniture-snap.mts"
import { PLANTS } from "./baby-flora-queue.mjs"

const ROOT = path.resolve(path.dirname(new URL(import.meta.url).pathname), "..")
const DIR = process.env.BABY_GENS_DIR || path.join(os.homedir(), "ComfyUI-Shared", "output")
const NOTES = path.join(ROOT, "data/baby-game-gens.json")
const PICKS = path.join(ROOT, "lib/baby-game/flora.json")
const OUT = path.join(ROOT, "lib/baby-game/flora-sprites.ts")
const CHARS = "0123456789abcdefghijklmnopqrstuvwxyz"

/** Pixel height of each plant on the ground (a tile is 16 px, a baby animal about 14). */
export const HEIGHT: Record<string, number> = {
  daisy: 14, poppy: 14, tulip: 14, pompom: 16, bluebell: 15, clover: 10, buttercup: 11, lavender: 16,
  fern: 16, calathea: 15, mushroom: 12, moss: 9, foxglove: 18,
  lilypad: 10, cattail: 22, iris: 17, glowshroom: 12,
  snowdrop: 12, orchid: 17, tillandsia: 14,
  cactus: 13, succulent: 11, dunegrass: 13, sprout: 9, berrybush: 18, monstera: 18,
}

type Verdicts = Record<string, { verdict?: string | null }>

/** `flora-<id>_00001_.png` and `flora-r2-<id>_00001_.png`: the id is what follows the optional round. */
function filesOf(id: string): string[] {
  const re = new RegExp(`^flora-(r\\d+-)?${id}_\\d+_\\.png$`)
  // later rounds sort after earlier ones, then by counter
  const round = (f: string) => Number(/^flora-r(\d+)-/.exec(f)?.[1] ?? 0)
  return fs.readdirSync(DIR).filter((f) => re.test(f)).sort((a, b) => round(a) - round(b) || a.localeCompare(b))
}

function pick(id: string, notes: Verdicts, picks: Record<string, string>): string | null {
  if (picks[id]) return picks[id]
  const files = filesOf(id)
  const liked = files.filter((f) => notes[f]?.verdict === "like")
  const fine = files.filter((f) => notes[f]?.verdict !== "nope")
  return liked.at(-1) ?? fine.at(-1) ?? files.at(-1) ?? null
}

async function main() {
  const rawNotes = fs.existsSync(NOTES) ? JSON.parse(fs.readFileSync(NOTES, "utf8")) : {}
  const notes: Verdicts = rawNotes.notes ?? rawNotes
  const picks: Record<string, string> = fs.existsSync(PICKS) ? JSON.parse(fs.readFileSync(PICKS, "utf8")) : {}
  const out: Record<string, Snapped> = {}
  const missing: string[] = []
  for (const id of Object.keys(PLANTS)) {
    // PINNED=1: only the plants `flora.json` names, while a round is still being drawn
    if (process.env.PINNED && !picks[id]) continue
    const file = pick(id, notes, picks)
    const snapped = file ? await snap(id, file, HEIGHT[id] ?? 14) : null
    if (snapped) {
      out[id] = snapped
      console.log(`${id}: ${file}${notes[file!]?.verdict === "like" ? " ♥" : ""}`)
    } else missing.push(id)
  }
  const body = Object.entries(out)
    .map(([id, s]) => `  ${JSON.stringify(id)}: {\n    w: ${s.w},\n    h: ${s.h},\n    pal: ${JSON.stringify(s.pal)},\n    rows: [\n${s.rows.map((r) => `      "${r}",`).join("\n")}\n    ],\n  },`)
    .join("\n")
  fs.writeFileSync(
    OUT,
    `/**
 * lib/baby-game/flora-sprites.ts — GENERATED by scripts/baby-flora-snap.mts. Do not edit.
 *
 * The ground's plants, drawn in ComfyUI (\`scripts/baby-flora-queue.mjs\`), liked in \`/lab/baby-gens\` and snapped down: each is a
 * palette (the last color is the outline) and rows of palette characters, "." empty. \`components/BabyGame/flora.ts\` paints them.
 */

export type FloraSprite = { w: number; h: number; pal: string[]; rows: string[] }

export const FLORA_SPRITES: Record<string, FloraSprite> = {
${body}
}
`,
  )
  console.log(`${Object.keys(out).length} plants written; missing: ${missing.join(", ") || "none"}`)
  const preview = process.argv[2]
  if (preview) {
    const cols = 9, cell = 84, sc = 4
    const tiles = Object.entries(out)
    const unhex = (h: string) => [parseInt(h.slice(1, 3), 16), parseInt(h.slice(3, 5), 16), parseInt(h.slice(5, 7), 16)]
    const comps = await Promise.all(
      tiles.map(async ([id, s], i) => {
        const buf = Buffer.alloc(s.w * s.h * 4)
        s.rows.forEach((r, y) => [...r].forEach((ch, x) => {
          if (ch === ".") return
          const c = unhex(s.pal[CHARS.indexOf(ch)]!)
          buf.set([c[0]!, c[1]!, c[2]!, 255], (y * s.w + x) * 4)
        }))
        const img = await sharp(buf, { raw: { width: s.w, height: s.h, channels: 4 } }).resize(Math.min(cell - 4, s.w * sc), Math.min(cell - 16, s.h * sc), { kernel: "nearest", fit: "inside" }).png().toBuffer()
        return [
          { input: img, left: (i % cols) * cell + 2, top: Math.floor(i / cols) * cell + 14 },
          { input: Buffer.from(`<svg width="${cell}" height="14"><text x="2" y="11" font-size="10" font-family="Arial" fill="#222">${id}</text></svg>`), left: (i % cols) * cell, top: Math.floor(i / cols) * cell },
        ]
      }),
    )
    await sharp({ create: { width: cols * cell, height: Math.ceil(tiles.length / cols) * cell, channels: 3, background: "#9fc58a" } }).composite(comps.flat()).png().toFile(preview)
  }
}

main().catch((e) => (console.error(e), process.exit(1)))
