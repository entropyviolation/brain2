/**
 * scripts/baby-gen-sprites.mts — Liked ComfyUI generations into game sprites
 *
 *   npx tsx scripts/baby-gen-sprites.mts --parts <png> [out.png]   number the figures on a sheet (pick views by number)
 *   npx tsx scripts/baby-gen-sprites.mts [preview.png]             snap every view in the manifest, write gen-sprites.ts
 *
 * The manifest is `lib/baby-game/gen-sprites.json`: per game id, the source file (in the ComfyUI output folder), which
 * figure on it, its height in grid rows, and whether to mirror it, for each of the front, side and back views. The
 * snapping is `lib/baby-game/snap.mjs`. The output is `lib/baby-game/gen-sprites.ts`, which `spriteGrid` reads first.
 */

import fs from "node:fs"
import os from "node:os"
import path from "node:path"
import sharp from "sharp"
import { faceless, figureMask, parts, place, snapPart } from "../lib/baby-game/snap.mjs"
import { SPRITE_PALETTE } from "../lib/baby-game/sprites"

const ROOT = path.resolve(path.dirname(new URL(import.meta.url).pathname), "..")
const DIR = process.env.BABY_GENS_DIR || path.join(os.homedir(), "ComfyUI-Shared", "output")
const MANIFEST = path.join(ROOT, "lib/baby-game/gen-sprites.json")
const OUT = path.join(ROOT, "lib/baby-game/gen-sprites.ts")

type ViewSrc = { file: string; part: number; height: number; flip?: boolean; tol?: number; skip?: string; faceless?: boolean; shadow?: boolean }
type Entry = { from: string; views: Record<"front" | "side" | "back", ViewSrc> }
type Manifest = Record<string, Entry>

async function load(file: string) {
  const { data, info } = await sharp(path.join(DIR, file)).removeAlpha().raw().toBuffer({ resolveWithObject: true })
  return { rgba: toRgba(data, info.width * info.height), w: info.width, h: info.height }
}

function toRgba(rgb: Buffer, n: number) {
  const out = new Uint8Array(n * 4)
  for (let i = 0; i < n; i++) ((out[i * 4] = rgb[i * 3]!), (out[i * 4 + 1] = rgb[i * 3 + 1]!), (out[i * 4 + 2] = rgb[i * 3 + 2]!), (out[i * 4 + 3] = 255))
  return out
}

async function numberParts(file: string, out: string) {
  const { rgba, w, h } = await load(file)
  const found = parts(figureMask(rgba, w, h), w, h)
  const boxes = found
    .map((p) => `<rect x="${p.x0}" y="${p.y0}" width="${p.x1 - p.x0}" height="${p.y1 - p.y0}" fill="none" stroke="red" stroke-width="3"/><text x="${p.x0 + 4}" y="${p.y0 + 28}" font-size="28" fill="red" font-family="sans-serif">${p.index}</text>`)
    .join("")
  await sharp(path.join(DIR, file))
    .composite([{ input: Buffer.from(`<svg width="${w}" height="${h}">${boxes}</svg>`) }])
    .toFile(out)
  console.log(found.map((p) => `${p.index}: ${p.x1 - p.x0}×${p.y1 - p.y0} at ${p.x0},${p.y0}`).join("\n"))
}

async function snapAll(preview?: string) {
  const manifest = JSON.parse(fs.readFileSync(MANIFEST, "utf8")) as Manifest
  const grids: Record<string, Record<string, string[]>> = {}
  const cache = new Map<string, Awaited<ReturnType<typeof load>> & { mask: Uint8Array }>()
  for (const [id, entry] of Object.entries(manifest)) {
    grids[id] = {}
    for (const [view, src] of Object.entries(entry.views)) {
      const key = `${src.file}:${src.tol ?? 60}:${!!src.shadow}`
      let img = cache.get(key)
      if (!img) {
        const l = await load(src.file)
        img = { ...l, mask: figureMask(l.rgba, l.w, l.h, src.tol ?? 60, { shadow: !!src.shadow }) }
        cache.set(key, img)
      }
      const found = parts(img.mask, img.w, img.h)
      const part = found[src.part]
      if (!part) throw new Error(`${id} ${view}: ${src.file} has ${found.length} figures, no #${src.part}`)
      const grid = place(snapPart(img.rgba, img.w, part, SPRITE_PALETTE, src.height, { skip: src.skip ?? "" }), { flip: src.flip })
      grids[id]![view] = src.faceless ? faceless(grid) : grid
    }
  }
  const body = Object.entries(grids)
    .map(([id, views]) => {
      const vs = Object.entries(views).map(([v, rows]) => `    ${v}: [\n${rows.map((r) => `      "${r}",`).join("\n")}\n    ],`)
      return `  ${JSON.stringify(id)}: {\n${vs.join("\n")}\n  },`
    })
    .join("\n")
  const from = Object.entries(manifest).map(([id, e]) => ` * - ${id}: ${e.from}`).join("\n")
  fs.writeFileSync(
    OUT,
    `/**\n * lib/baby-game/gen-sprites.ts — GENERATED by scripts/baby-gen-sprites.mts from lib/baby-game/gen-sprites.json. Do not edit.\n *\n * Friends drawn from liked ComfyUI generations, snapped to 32×32 letter grids (\`snap.mjs\`). \`spriteGrid\` reads these first.\n${from}\n */\n\nexport const GEN_GRIDS: Record<string, { front: string[]; side: string[]; back: string[] }> = {\n${body}\n}\n`,
  )
  console.log(`wrote ${path.relative(ROOT, OUT)} (${Object.keys(grids).join(", ")})`)
  if (preview) await renderPreview(grids, preview)
}

/** Every view at 6×, a row per id, for a quick look. */
async function renderPreview(grids: Record<string, Record<string, string[]>>, out: string) {
  const Z = 6
  const ids = Object.keys(grids)
  const W = 3 * 32 * Z
  const H = ids.length * 32 * Z
  const buf = Buffer.alloc(W * H * 3, 0xd8)
  ids.forEach((id, row) =>
    ["front", "side", "back"].forEach((v, col) => {
      const g = grids[id]![v]!
      g.forEach((line, y) =>
        [...line].forEach((ch, x) => {
          const hexc = SPRITE_PALETTE[ch]
          if (!hexc) return
          const c = [1, 3, 5].map((i) => parseInt(hexc.slice(i, i + 2), 16))
          for (let dy = 0; dy < Z; dy++)
            for (let dx = 0; dx < Z; dx++) {
              const i = ((row * 32 + y) * Z + dy) * W + (col * 32 + x) * Z + dx
              buf.set(c, i * 3)
            }
        }),
      )
    }),
  )
  await sharp(buf, { raw: { width: W, height: H, channels: 3 } }).png().toFile(out)
  console.log(`preview ${out}`)
}

const args = process.argv.slice(2)
if (args[0] === "--parts") await numberParts(args[1]!, args[2] ?? "parts.png")
else await snapAll(args[0])
