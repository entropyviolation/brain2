{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mockups",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "exec python3 -m http.server \"${PORT:-8765}\" --bind 127.0.0.1"
      ],
      "port": 8765,
      "autoPort": true
    },
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "app (running)",
      "url": "http://localhost:3000"
    },
    {
      "name": "ios-out",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd out && exec python3 -m http.server \"${PORT:-8790}\" --bind 127.0.0.1"
      ],
      "port": 8790,
      "autoPort": true
    },
    {
      "name": "dev-3010",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "PORT=3010 BRAIN2_ALLOW_SECOND_SERVER=1 exec npm run dev"
      ],
      "port": 3010
    }
  ]
}
