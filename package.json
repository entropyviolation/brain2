{
  "name": "cogs",
  "version": "0.1.0",
  "private": true,
  "description": "COGS - Cognitive Offloading and Getting Stuff Done",
  "author": "COGS",
  "main": "electron/main.js",
  "scripts": {
    "dev": "bash -c 'ulimit -n 10240 2>/dev/null; unset ELECTRON_RUN_AS_NODE; export LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8; exec node scripts/cogs-dev-server.mjs'",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "tree": "bash scripts/update-tree.sh",
    "capture-screenshots": "node scripts/capture-screenshots.mjs",
    "electron": "electron .",
    "electron:dev": "bash -c 'ulimit -n 10240 2>/dev/null; unset ELECTRON_RUN_AS_NODE; export LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8; exec concurrently -k -n next,electron -c blue,green \"npm run dev\" \"wait-on tcp:3000 && electron .\"'",
    "electron:build": "next build && electron-builder",
    "electron:build:dir": "next build && electron-builder --dir",
    "mobile:sync": "node scripts/mobile-sync-server.mjs",
    "mobile:dev": "npm run dev",
    "mobile:cap:sync": "bash -c 'export LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8; npx cap sync ios'",
    "mobile:ios:init": "bash -c 'export LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8; npm run build && npx cap add ios && node scripts/mobile-ios-ats.mjs && npx cap sync ios'",
    "mobile:ios": "bash -c 'export LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8; npm run build && node scripts/mobile-ios-ats.mjs && npx cap sync ios && npx cap open ios'"
  },
  "dependencies": {
    "@capacitor/core": "^7.6.8",
    "@capacitor/ios": "^7.6.8",
    "@radix-ui/react-checkbox": "latest",
    "@radix-ui/react-collapsible": "latest",
    "@radix-ui/react-dialog": "1.1.4",
    "@radix-ui/react-dropdown-menu": "2.1.4",
    "@radix-ui/react-label": "latest",
    "@radix-ui/react-progress": "1.1.1",
    "@radix-ui/react-select": "2.1.4",
    "@radix-ui/react-separator": "1.1.1",
    "@radix-ui/react-slot": "1.1.1",
    "@radix-ui/react-switch": "1.1.2",
    "@radix-ui/react-tabs": "1.1.2",
    "@radix-ui/react-tooltip": "1.1.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "latest",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.454.0",
    "next": "15.2.4",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^4.10.38",
    "react": "^19",
    "react-dom": "^19",
    "react-leaflet": "^5.0.0",
    "recharts": "latest",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3",
    "zustand": "latest"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.8",
    "@playwright/test": "^1.61.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "jsdom": "^29.1.1",
    "playwright": "^1.49.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.17",
    "typescript": "^5",
    "vitest": "^4.1.9",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.cogs.app",
    "productName": "COGS",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "out/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    }
  }
}
